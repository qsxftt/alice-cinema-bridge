# ==============================================================================
# Alice Cinema Bridge - Конфигурация окружения
# Скопируйте этот файл в .env и укажите свои параметры:
#   cp .env.example .env
# ==============================================================================

# Локальный IP и порт сервера (где запущен cinema_webhook.py)
SERVER_LAN_IP=192.168.1.100
SERVER_PORT=8888

# Секретный токен для защиты вебхука от несанкционированного доступа
# Должен совпадать с параметром ?secret=... в URL вебхука в Яндекс Диалогах
SECRET_TOKEN=cinema_secret_token_change_me

# API Кинопоиска (бесплатный ключ берется на https://poiskkino.dev/)
KINOPOISK_API_KEY=your_poiskkino_api_key_here
KINOPOISK_URL=https://api.poiskkino.dev/v1.4/movie/search

# Адрес и API-ключ Prowlarr (панель Prowlarr -> Settings -> General -> API Key)
PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here

# Адрес TorrServer
TORRSERVER_URL=http://127.0.0.1:8090

# IP-адрес проектора или Android TV в локальной сети
PROJECTOR_IP=192.168.1.116

# Публичный домен Tailscale Funnel (для сквозного мониторинга в watchdog)
TAILSCALE_FUNNEL_DOMAIN=homeserver.your-tailnet.ts.net

# Режим подтверждения:
# false - умный запуск без лишних вопросов (Smart Confidence)
# true  - всегда переспрашивать "Включить X Y года?"
ALWAYS_CONFIRM=false
